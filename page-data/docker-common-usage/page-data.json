ntmatter":{"title":"Docker","date":"March 29, 2023","description":null,"tags":null}},"previous":{"fields":{"slug":"/laravel-getting-started/"},"frontmatter":{"title":"Laravel on macOS + Apple Silicon"}},"next":{"fields":{"slug":"/magento-mac-setup-apache/"},"frontmatter":{"title":"Setup Magento 2 with Apache on MacOS"}}},"pageContext":{"id":"728127ea-0283-58b6-9403-cea44375f439","previousPostId":"5efa174f-6334-50cd-8887-ec0fd89bbc5a","nextPostId":"aad33bfa-7f4e-5ea6-9af1-37381e71f38e"}},"staticQueryHashes":["3351346743","3517523002","4021987012"]}